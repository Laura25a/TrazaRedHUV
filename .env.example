# TrazaRed HUV — plantilla de variables de entorno.
# Copia este archivo como ".env" (o "pass.env") en la raíz y llena los valores.
# El .env real NUNCA se sube al repositorio (.gitignore lo excluye): se comparte
# por un canal privado. Si un secreto llega a un commit, borrarlo no basta: se rota.

# ── Obligatorias ──────────────────────────────────────────────────────────
# firma de los JWT
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# en Docker la fija docker-compose
PG_CONNECTION_STRING=postgresql://usuario:clave@host:5432/base
# en Docker la fija docker-compose
MONGO_CONNECTION_STRING=mongodb://host:27017/
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ── Usuarios de demostración (uno por rol; si falta la variable, no se crea) ──
DEMO_ADMIN_PASSWORD=
DEMO_MEDICO_PASSWORD=
DEMO_ESPECIALISTA_PASSWORD=
DEMO_CONTABLE_PASSWORD=
DEMO_PACIENTE_PASSWORD=
DEMO_EPS_PASSWORD=
DEMO_DIRECTOR_PASSWORD=
DEMO_BIOMEDICO_PASSWORD=

# ── Asistente clínico (opcional: sin llave usa el modelo simulado) ─────────
GROQ_API_KEY=

# ── Proyecto final · Seguridad (R27, R28, R29) ────────────────────────────
# Si NO se definen, cada llave se deriva de SECRET_KEY (cómodo para desarrollo).
# En producción defínelas: así rotar SECRET_KEY no deja ilegibles los datos cifrados.
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Si defines LLAVE_CIFRADO o LLAVE_INDICE después, la API migra los datos sola al arrancar.
# LLAVE_AUDITORIA se define ANTES del primer arranque y no se cambia: cambiarla hace que
# la verificación marque como alterados los registros ya sellados.
# AES-256-GCM de documento, teléfono, dirección y correo (v1)
LLAVE_CIFRADO=
# para ROTAR: agrégala, reinicia la API y POST /seguridad/cifrado/rotar
# LLAVE_CIFRADO_V2=
# HMAC del índice ciego (búsqueda por documento sin descifrar)
LLAVE_INDICE=
# HMAC de la cadena de auditoría
LLAVE_AUDITORIA=
# HMAC del seudónimo del paciente hacia la IA
LLAVE_SEUDONIMO=
# el que HAPI envía en X-Webhook-Secret al avisar una Observation
FHIR_WEBHOOK_SECRET=
# vigencia del token de usuario
JWT_MINUTOS=30

# Límites y guardia del asistente (valores por defecto)
# LIMITE_VENTANA_S=10  LIMITE_SENSIBLE=10  LIMITE_SOCIO=30  LIMITE_IA=20  LIMITE_GENERAL=300
# GUARDIA_MAX_INTENTOS=3  GUARDIA_VENTANA_MIN=10  GUARDIA_BLOQUEO_MIN=15

# ── Proyecto final · Interoperabilidad (R30–R32) ──────────────────────────
INSTITUCION_NOMBRE=Hospital Universitario del Valle
# igual en los DOS equipos; si se deja vacío usa el de la demo de clase
SECRETO_FEDERADO=
# SID_FEDERADO=urn:salud-digital:sid-federado
# Las credenciales del sistema socio NO van aquí: el admin las registra en
# Interoperabilidad > Instituciones socias y quedan cifradas en la base.

# ── Túnel con URL fija (opcional) ─────────────────────────────────────────
# TUNNEL_TOKEN=


# Docker local. Genera un valor hexadecimal aleatorio distinto para cada variable.
TRAZARED_PG_PASSWORD=
TRAZARED_HAPI_PG_PASSWORD=
TRAZARED_MONGO_PASSWORD=
TRAZARED_ORTHANC_PASSWORD=
