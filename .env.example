# TrazaRed HUV - plantilla de variables de entorno (lo UNICO de credenciales que va en el repo)
# Copia este archivo como .env (o usa tu pass.env) y llenalo con valores reales.
# El .env / pass.env NUNCA se sube al repositorio: las claves se comparten por canal privado.

PG_CONNECTION_STRING=postgresql://USUARIO:CONTRASENA@EP-XXXX.neon.tech/NOMBREBD?sslmode=require
MONGO_CONNECTION_STRING=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
FHIR_BASE_URL=http://localhost:8081/fhir

# Genera la tuya con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-propia
# Dominios que pueden llamar a la API (CORS), separados por comas. Nunca "*".
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Usuarios de prueba, uno por rol (R01)
DEMO_ADMIN_PASSWORD=clave_del_admin_de_prueba
DEMO_MEDICO_PASSWORD=clave_del_medico_de_prueba
DEMO_ESPECIALISTA_PASSWORD=clave_del_especialista_de_prueba
DEMO_CONTABLE_PASSWORD=clave_del_contable_de_prueba
DEMO_PACIENTE_PASSWORD=clave_del_paciente_de_prueba
DEMO_EPS_PASSWORD=clave_de_la_eps_de_prueba
