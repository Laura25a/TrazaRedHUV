# TrazaRed HUV — plantilla de variables de entorno
#
# Copia este archivo como "pass.env" (en la raíz del proyecto) y llénalo con
# valores reales. pass.env NUNCA se sube al repositorio (está en .gitignore):
# las credenciales se comparten por canal privado.
#
# Nota: python/fhir_sync.py carga python/pass.env; si ejecutas la sincronización
# desde python/ con "python fhir_sync.py", copia también el archivo allí.

# PostgreSQL (Neon) — cadena de conexión de la base relacional
PG_CONNECTION_STRING=postgresql://USUARIO:CONTRASENA@EP-XXXX.neon.tech/NOMBREBD?sslmode=require

# MongoDB (Atlas) — cadena de conexión del cluster (base trazared_huv)
MONGO_CONNECTION_STRING=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Clave para firmar los JWT de la API (genera la tuya, p. ej. con secrets.token_hex(32))
SECRET_KEY=cambia-esta-clave-por-una-propia

# Servidor HAPI FHIR — el docker-compose lo publica en el puerto 8081 del host
FHIR_BASE_URL=http://localhost:8081/fhir
